# sphinx - configuration.
# Copy to `sphinx.toml` (gitignored) and keep the coordinates in sync with
# `/auctimogger semaphore coords` after any window resize. All points are WoW
# client-area physical pixels (window movement is compensated at use time).

poll_ms = 50           # poll period; contract wants >=20 Hz (<=50 ms)
kill_hotkey = "ctrl+alt+f12" # HOLD to kill sphinx within one poll; no hook, GetAsyncKeyState
require_foreground = true    # sendinput: refuse to actuate unless WoW is foreground
focus_if_needed = false      # sendinput: best-effort SetForegroundWindow first (Windows may refuse)
debounce_ms = 25       # same CMD color on two polls at least this far apart
watchdog_ms = 10000    # strobe white longer than this -> idle, never re-actuate
min_actuation_interval_ms = 250 # burst guard: two actuations closer than this = runaway, second refused
max_actuations_per_min = 30     # burst guard: rolling ceiling; excess actuations are skipped (logged)
jitter_px = 3            # humanize: click targets offset +-this many px per axis (0 = exact)
hold_ms = 35             # humanize: base down->up hold for a click
hold_jitter_pct = 20     # humanize: hold randomized +-this percent around the base
settle_jitter_pct = 25   # humanize: converge settle gaps randomized +-this percent
reaction_min_ms = 15     # humanize: pre-actuation pause, uniform in [min, max] (0 max disables)
reaction_max_ms = 50     # humanize: max reaction pause; ABORT is never delayed or jittered

# Calibration reference dumped by `/auctimogger semaphore coords` (doctor compares the
# live desktop against it; sphinx never derives coordinates from these).
# NOTE: keep these lines ABOVE every [section] - they are top-level keys.
screen   = { width = 1920, height = 1080 }
ui_scale = 0.65

[pixels]              # REQUIRED, from `/auctimogger semaphore coords` (no defaults)
cmd    = { x = 7, y = 7 }
strobe = { x = 7, y = 15 }

[targets]              # REQUIRED, live button centers from `/auctimogger semaphore coords`
buyout  = { x = 304, y = 434 }  # commodity buy screen's Buy Now button
confirm = { x = 285, y = 315 }  # buy dialog's Buy Now button
# Optional: the ITEM buy screen's Buyout button (non-stackable deals). Run
# coords with an item listing open to get it; without it the BUYOUT-ITEM
# command (cyan) logs and is skipped:
# buyout_item = { x = 713, y = 583 }
# Optional: the item confirm popup's accept button (StaticPopup1). Run coords
# while that popup is open (hand-buy an item, leave the popup up) to get it;
# without it the CONFIRM-ITEM command (blue) logs and is skipped - NOTE the
# addon first tries clicking the popup itself, so this target only matters
# when the fork refuses that:
# confirm_item = { x = 960, y = 586 }
# Optional: the fork's search-gate targets. The gate only answers hardware
# searches, so when an ITEM deal is found hands-off the addon fills the
# search box and sphinx supplies the clicks: SEARCH-ITEM (orange) presses
# the search button, BROWSE-ROW (purple) clicks the browse list's first row.
# search_item = { x = 1810, y = 28 }   # run coords with the AH open
# browse_row = { x = 400, y = 130 }    # run coords with browse results on screen

[abort_key]
key = "escape"         # v1 supports "escape" only (BuyDialog cancel path)

[afk_key]
key = "space"          # key tapped once per AFK semaphore edge (addon-cadenced
                       # idle reset, active sessions only). Bind this key in
                       # WoW to a spell/buff or jump; any key-name the kill
                       # hotkey accepts works (letters, digits, f1-f24, ...);
                       # modifiers and "escape" are rejected.

[backend]
# "sendinput" (default), "serial" (build with --features serial), or "vkbm"
# (versa-kbm RP2040 dongle; on by default since sphinx 0.1). Override per
# invocation with `--backend vkbm|sendinput|serial` - it wins over this file.
kind = "sendinput"
# Game discovery matches these image names (case-insensitive). Defaults:
# wowb.exe, wow.exe, wowclassic.exe, wow-64.exe. Override only if yours differs:
# window = { process_names = ["wowb.exe"] }
# With several clients open, pin discovery to the right window (title substring,
# case-insensitive). Without it, the largest visible client wins:
# window = { title_filter = "World of Warcraft" }

# versa-kbm backend (kind = "vkbm", --features vkbm). Every key defaults, so
# the bare kind works; the table is optional. The board must be armed (solid
# blue LED) for actuation - BOOTSEL toggles the hardware switch.
# [backend.vkbm]
# vid = 0x258a           # USB vendor id to scan for (firmware default)
# pid = 0x0100           # USB product id to scan for (firmware default)
# ack_timeout_ms = 250   # per-attempt ack deadline (10..=1000); a lost ack is
#                        # resent once - keep well under the device's 2 s
#                        # replay window so the resend stays deduped
# move_mode = "relative" # pointer placement (default): closed loop over true
#                        # relative reports, works on every monitor; needs
#                        # firmware 0.5+. "abs" = one absolute HID report
#                        # (primary monitor only); "auto" = abs on the
#                        # primary, closed loop elsewhere.
# move_profile = "move-profile.toml"  # calibration written by
#                        # `sphinx calibrate-move`; seeds the closed loop
#                        # with your measured pointer-ballistics curve.
