# sphinx - configuration.
# Copy to `sphinx.toml` (gitignored) and keep the coordinates in sync with
# `/am semaphore coords` after any window resize. All points are WoW
# client-area physical pixels (window movement is compensated at use time).

poll_ms = 50           # poll period; contract wants >=20 Hz (<=50 ms)
kill_hotkey = "ctrl+alt+f12" # HOLD to kill sphinx within one poll; no hook, GetAsyncKeyState
require_foreground = true    # sendinput: refuse to actuate unless WoW is foreground
focus_if_needed = false      # sendinput: best-effort SetForegroundWindow first (Windows may refuse)
debounce_ms = 25       # same CMD color on two polls at least this far apart
watchdog_ms = 10000    # strobe white longer than this -> idle, never re-actuate
min_actuation_interval_ms = 250 # burst guard: two actuations closer than this = runaway, second refused
max_actuations_per_min = 30     # burst guard: rolling ceiling; excess actuations are skipped (logged)

# Calibration reference dumped by `/am semaphore coords` (doctor compares the
# live desktop against it; sphinx never derives coordinates from these).
# NOTE: keep these lines ABOVE every [section] - they are top-level keys.
screen   = { width = 1920, height = 1080 }
ui_scale = 0.65

[pixels]               # REQUIRED, from `/am semaphore coords` (no defaults)
cmd    = { x = 7, y = 7 }
strobe = { x = 7, y = 15 }

[targets]              # REQUIRED, live button centers from `/am semaphore coords`
buyout  = { x = 304, y = 434 }
confirm = { x = 285, y = 315 }

[abort_key]
key = "escape"         # v1 supports "escape" only (BuyDialog cancel path)

[backend]
kind = "sendinput"     # "sendinput" (default) or "serial" (build with --features serial)
# Game discovery matches these image names (case-insensitive). Defaults:
# wowb.exe, wow.exe, wowclassic.exe, wow-64.exe. Override only if yours differs:
# window = { process_names = ["wowb.exe"] }
# With several clients open, pin discovery to the right window (title substring,
# case-insensitive). Without it, the largest visible client wins:
# window = { title_filter = "World of Warcraft" }
